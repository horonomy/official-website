{
  "$schema": "./design-token-contract.schema.json",
  "version": 1,
  "source": {"file": "src/css/custom.css", "selector": "first top-level :root", "prefix": "--hn-"},
  "consumers": {"website": "src/", "atlas": "atlas/tokens.mjs"},
  "contracts": {"visual": "design/VISUAL_DESIGN_CONSTITUTION.md", "motion": "design/MOTION_CONSTITUTION.md", "accessibility": "design/ACCESSIBILITY_CONTRACT.md"},
  "tokens": {
    "surface.canvas": {"type": "color", "css": "--hn-graphite"},
    "surface.deep": {"type": "color", "css": "--hn-graphite-deep"},
    "surface.panel": {"type": "color", "css": "--hn-panel"},
    "text.heading": {"type": "color", "css": "--hn-ink"},
    "text.body": {"type": "color", "css": "--hn-text"},
    "text.secondary": {"type": "color", "css": "--hn-muted"},
    "decoration.faint": {"type": "color", "css": "--hn-faint"},
    "decoration.line": {"type": "color", "css": "--hn-line"},
    "decoration.lineStrong": {"type": "color", "css": "--hn-line-strong"},
    "accent.active": {"type": "color", "css": "--hn-cyan"},
    "accent.review": {"type": "color", "css": "--hn-amber"},
    "accent.celestial": {"type": "color", "css": "--hn-gold"},
    "accent.celestialBright": {"type": "color", "css": "--hn-gold-bright"},
    "accent.celestialSoft": {"type": "color", "css": "--hn-gold-soft"},
    "font.sans": {"type": "fontFamily", "css": "--hn-font-sans"},
    "font.mono": {"type": "fontFamily", "css": "--hn-font-mono"},
    "layout.shellMax": {"type": "dimension", "css": "--hn-shell-max"},
    "layout.gutter": {"type": "dimension", "css": "--hn-gutter"},
    "space.1": {"type": "dimension", "css": "--hn-space-1"},
    "space.2": {"type": "dimension", "css": "--hn-space-2"},
    "space.3": {"type": "dimension", "css": "--hn-space-3"},
    "space.4": {"type": "dimension", "css": "--hn-space-4"},
    "space.5": {"type": "dimension", "css": "--hn-space-5"},
    "space.6": {"type": "dimension", "css": "--hn-space-6"},
    "space.7": {"type": "dimension", "css": "--hn-space-7"},
    "space.8": {"type": "dimension", "css": "--hn-space-8"},
    "radius.control": {"type": "dimension", "css": "--hn-radius-sm"},
    "radius.panel": {"type": "dimension", "css": "--hn-radius-md"},
    "radius.pill": {"type": "dimension", "css": "--hn-radius-pill"},
    "shadow.small": {"type": "shadow", "css": "--hn-shadow-sm"},
    "shadow.medium": {"type": "shadow", "css": "--hn-shadow-md"},
    "shadow.large": {"type": "shadow", "css": "--hn-shadow-lg"},
    "focus.color": {"type": "color", "css": "--hn-focus-ring-color"},
    "focus.ring": {"type": "shadow", "css": "--hn-focus-ring"},
    "glass.background": {"type": "gradient", "css": "--hn-glass-bg"},
    "glass.filter": {"type": "filter", "css": "--hn-glass-blur"},
    "glass.border": {"type": "color", "css": "--hn-glass-border"},
    "glass.highlight": {"type": "shadow", "css": "--hn-glass-highlight"}
  },
  "authoring": {
    "values": "CSS owns values and var() aliases; this manifest maps roles without duplicating values. Role names do not create CSS aliases.",
    "responsive": "CSS media queries own overrides; custom.css documents 996px/560px, atlas/atlas.css owns its 720px grid collapse and local gutter. Atlas extraction copies only the first root block.",
    "motion": "MOTION_CONSTITUTION.md owns v1 ranges. HORO-873 may add shared duration/easing tokens to the CSS source and extend this manifest; no such runtime tokens exist in this v1 inventory.",
    "validation": "Validate against the sibling JSON Schema, then verify every css reference and its var() dependencies resolve in the extracted source. Schema validity alone does not prove source parity or rendered contrast.",
    "distribution": "Atlas uses its existing extractor. Other authorized web consumers record the source commit and map roles locally; do not copy corporate layout or publish a new token package. Pets does not consume this palette."
  }
}
