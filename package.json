{
  "name": "@horonomy/official-website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "check:claims": "node scripts/check-product-claims.mjs",
    "check:registry": "node scripts/validate-product-registry.mjs",
    "build:atlas": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types atlas/build.mts",
    "test:atlas": "node --test atlas/test/*.test.mjs",
    "typecheck:atlas": "tsc -p atlas",
    "check:visual": "node scripts/visual-qa/run.mjs rendered",
    "perf:visual": "node scripts/visual-qa/run.mjs performance",
    "test:visual-tools": "node --test scripts/visual-qa/*.test.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "typescript": "~6.0.2",
    "wrangler": "4.131.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "^1.1.18",
      "browserslist": "^4.28.7",
      "fast-uri": "^3.1.6",
      "js-yaml": "^4.3.2",
      "nanoid": "^3.3.18",
      "postcss": "^8.5.23",
      "serialize-javascript": "^7.0.5",
      "svgo": "^3.3.5",
      "baseline-browser-mapping": "^2.11.0",
      "colord": "^2.9.4",
      "qs": "^6.16.0",
      "joi": "^17.13.6",
      "@swc/html": "^1.16.2",
      "image-size": "^2.0.3",
      "sockjs>uuid": "^11.1.1"
    }
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
